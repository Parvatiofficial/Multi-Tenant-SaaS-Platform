// DocuMind AI Multi-Tenant Core & Vector Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum PlanTier {
  FREE
  STARTER
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Tenant represents the isolated organization boundary
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      PlanTier @default(FREE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  documents      Document[]
  documentChunks DocumentChunk[]

  @@map("tenants")
}

/// User represents global credentials across the platform
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Membership represents the many-to-many RBAC association between a User and a Tenant
model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

/// RefreshToken stores hashed session tokens for rotation and revocation
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Document stores uploaded file metadata and pipeline processing status
model Document {
  id           String         @id @default(uuid())
  tenantId     String         @map("tenant_id")
  title        String
  fileKey      String         @map("file_key")
  fileSize     Int            @map("file_size")
  mimeType     String         @map("mime_type")
  status       DocumentStatus @default(PENDING)
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([tenantId, status])
  @@map("documents")
}

/// DocumentChunk stores segmented text snippets and 1536-dimensional vector embeddings
model DocumentChunk {
  id         String                                @id @default(uuid())
  documentId String                                @map("document_id")
  tenantId   String                                @map("tenant_id")
  content    String                                @db.Text
  pageNumber Int?                                  @map("page_number")
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                              @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@map("document_chunks")
}
