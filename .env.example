# ------------------------------------------------------------------------------
# App Environment Variables (Default Local Configuration)
# ------------------------------------------------------------------------------

# Node Environment
NODE_ENV=development

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documind_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documind_db?schema=public

# Redis (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend API (NestJS)
API_PORT=4000
API_URL=http://localhost:4000
API_CORS_ORIGIN=http://localhost:3000

# Frontend (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Security & JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_jwt_key_documind_32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_documind_32chars!
JWT_REFRESH_EXPIRES_IN=7d

# AI & Embeddings (Optional for Mock mode)
OPENAI_API_KEY=sk-placeholder-mock-for-local-dev
